{
  "name": "pixu-assets",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "css:watch": "tailwindcss -i ./assets/css/input.css -o ./pixu/static/css/tailwind.css --watch",
    "css:build": "tailwindcss -i ./assets/css/input.css -o ./pixu/static/css/tailwind.css --minify",
    "htmx:copy": "node ./scripts/copy_htmx.mjs",
    "build": "npm run css:build && npm run htmx:copy"
  },
  "dependencies": {
    "htmx.org": "2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}

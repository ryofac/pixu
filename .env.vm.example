# Copie para .env.vm e importe no Portainer como variáveis da Stack.
# Não versione .env.vm nem coloque segredos neste arquivo.

# Tag das imagens privadas no GHCR. Prefira sha-<commit> para deploy reproduzível.
PIXU_IMAGE_TAG=main
PIXU_REDIS_IMAGE=redis:7.2

# Arquivo de configuração do Traefik existente na VM.
PIXU_TRAEFIK_CONFIG=/opt/pixu/traefik/traefik.yml

# Django e acesso HTTPS pelo hostname DuckDNS.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ADMIN_URL=admin/
# Repita este hostname em deploy/vm/traefik.yml antes de construir a imagem.
DJANGO_ALLOWED_HOSTS=pixu-seunome.duckdns.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://pixu-seunome.duckdns.org
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# OAuth social. Google exige um hostname HTTPS; não use o IP público bruto.
DJANGO_GOOGLE_OAUTH_CLIENT_ID=
DJANGO_GOOGLE_OAUTH_CLIENT_SECRET=
DJANGO_GITHUB_OAUTH_CLIENT_ID=
DJANGO_GITHUB_OAUTH_CLIENT_SECRET=

# E-mail SMTP usado pelo cadastro e recuperação de acesso.
DJANGO_EMAIL_BACKEND=pixu.accounts.email_backends.CeleryEmailBackend
CELERY_EMAIL_DELIVERY_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=pixu@example.com
DJANGO_EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_DEFAULT_FROM_EMAIL="Pixu <pixu@example.com>"
DJANGO_SERVER_EMAIL="Pixu <pixu@example.com>"
DJANGO_EMAIL_SUBJECT_PREFIX=[Pixu]

# PostgreSQL.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pixu
POSTGRES_USER=pixu
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Redis e Celery.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Comprovantes privados. FileSystemStorage usa o volume persistente pixu_vm_media.
PIXU_RECEIPT_MAX_BYTES=10485760
PIXU_RECEIPT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png
PIXU_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
PIXU_S3_BUCKET_NAME=pixu-private
PIXU_S3_ENDPOINT_URL=
PIXU_S3_REGION_NAME=us-east-1
PIXU_S3_ACCESS_KEY_ID=
PIXU_S3_SECRET_ACCESS_KEY=
PIXU_S3_ADDRESSING_STYLE=auto
PIXU_S3_USE_SSL=False

# Copy to .envs/.production/.django and replace every placeholder before deployment.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_SERVER_EMAIL=Pixu <PIXU_GOOGLE_ACCOUNT@gmail.com>
DJANGO_DEFAULT_FROM_EMAIL=Pixu <PIXU_GOOGLE_ACCOUNT@gmail.com>
DJANGO_EMAIL_SUBJECT_PREFIX=[Pixu]
# Google SMTP: use the full address of the dedicated account below.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=PIXU_GOOGLE_ACCOUNT@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_BACKEND=${DJANGO_EMAIL_BACKEND}
REDIS_URL=${REDIS_URL}
CELERY_BROKER_URL=${CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${CELERY_RESULT_BACKEND}
CELERY_EMAIL_DELIVERY_BACKEND=${CELERY_EMAIL_DELIVERY_BACKEND}
